# Public values from the Supabase project. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional: bot number shown as a "wa.me" shortcut when linking WhatsApp (digits only).
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=

# ---- Server only. Never prefix these with NEXT_PUBLIC_. ----
# Supabase > Project Settings > API keys > secret (service_role). Required for writes.
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the app, used in e-mail links (e.g. https://prumo.example.com).
APP_URL=http://localhost:3000

# Pluggy (https://dashboard.pluggy.ai). Free sandbox: set PLUGGY_INCLUDE_SANDBOX=true and use user-ok / password-ok.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_INCLUDE_SANDBOX=true
# Sent by Pluggy as the x-prumo-webhook-secret header (register with `npm run pluggy:webhook`). Min 24 chars.
PLUGGY_WEBHOOK_SECRET=

# Shared with the WhatsApp bot (bot/.env). Min 32 chars:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=
# Protects /api/cron/notifications (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
