# URL of the Prumo Next.js app (no trailing slash).
PRUMO_APP_URL=http://localhost:3000
# Same value as INTERNAL_API_SECRET in the app. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=
# Small local model used only when the app cannot parse a message by itself.
AI_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
# How often to fetch reminders to send (ms).
OUTBOX_INTERVAL_MS=30000
# Persistent WhatsApp session folder. Never commit it.
WHATSAPP_SESSION_PATH=./session
