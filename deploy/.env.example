# Prumo on one machine (deploy/compose.yaml). Copy to deploy/.env and fill in. Never commit .env.
# Generate each secret with:  openssl rand -hex 32

# "public" starts the Cloudflare Tunnel (leave empty to run only on the local network).
# Add "ai" (public,ai) for the local model of the bot; it needs ~2 GB of free RAM.
COMPOSE_PROFILES=public

# --- Public address (the hostname configured in the Cloudflare Tunnel) ---
APP_URL=https://prumo.seudominio.com.br

# --- Supabase Cloud (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Backups: Project Settings > Database > Connection string > "Session pooler" (works on IPv4).
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
BACKUP_KEEP_DAYS=14

# --- Pluggy / MeuPluggy (dashboard.pluggy.ai) ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_INCLUDE_SANDBOX=false
# Sent by Pluggy in the webhook header; register with scripts/pluggy-webhook.mjs (docs/DEPLOY.md).
PLUGGY_WEBHOOK_SECRET=

# --- Internal secrets ---
# App <-> bot (HMAC). The bot reads the same value.
INTERNAL_API_SECRET=
# Daily reminders job (tasks service).
CRON_SECRET=

# --- WhatsApp bot ---
# Number shown in the app for linking WhatsApp (digits with country code, e.g. 5511999990000).
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=
# true only together with the "ai" profile above.
AI_ENABLED=false
OLLAMA_MODEL=llama3.2:1b
OUTBOX_INTERVAL_MS=30000

# --- Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel > token) ---
TUNNEL_TOKEN=

# --- Local network port for http://<this machine>:LAN_PORT ---
LAN_PORT=8080
